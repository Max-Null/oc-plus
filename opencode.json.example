{
  "$schema": "https://opencode.ai/config.json",

  // ── 默认模型：provider名:模型名 ──
  // provider 名（如 ds）对应下方 provider 段的 key，模型名对应 provider.models 中的 key
  "model": "ds:deepseek-v4-pro",
  "default_agent": "双星",

  // ── 模型别名（agent markdown 中引用，deploy.mjs 部署时替换）──
  // ⚠️ 勿在本文件配置 modelAliases：OC 严格校验 opencode.json，未知键会抛
  //    ConfigInvalidError 导致启动失败（8/8 实际踩坑）。
  // 别名独立配置在 model-aliases.json（纯构建期配置，OC 不加载）：
  //   {
  //     "DS_MODEL_LOW": "ds:deepseek-v4-flash",     // 编码执行等轻量任务（Flash）
  //     "DS_MODEL_HIGH": "ds:deepseek-v4-pro",      // 推理、审查等重度任务（Pro）
  //     "DS_MODEL_VISION": "kimi:kimi-k3"           // 制图师（Kimi K3 多模态）
  //   }
  // ⚠️ Kimi 平台注意：中国站 platform.kimi.com → baseURL https://api.moonshot.cn/v1
  //    国际站 platform.kimi.ai → baseURL https://api.moonshot.ai/v1，key 不通用

  // ── 插件 ──
  // OC 桌面端 1.18.x 不支持 plugins/ 目录自动发现（会报 UnsupportedContentType）。
  // 本地插件必须使用 file:/// 绝对路径显式列出，npm 包用短名称。
  "plugin": [
    "~/.config/opencode/node_modules/superpowers",
    "opencode-acp@latest",
    "file:///C:/Users/你的用户名/.config/opencode/plugins/fractal-guardian.js",
    "file:///C:/Users/你的用户名/.config/opencode/plugins/agents-priority.ts"
  ],

  // ── 禁用 OC 内置压缩（由 opencode-acp 接管）──
  // ACP 安装命令：opencode plugin opencode-acp@latest --global
  "compaction": { "auto": false },

  // ── 模型提供商 ──
  "provider": {
    "ds": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": true
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "reasoning": true
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        // ⚠️ 替换为你的 DeepSeek API Key：https://platform.deepseek.com/api_keys
        "apiKey": "sk-your-deepseek-api-key",
        "baseURL": "https://api.deepseek.com/v1",
        "setCacheKey": true
      }
    },

    // kimi provider：制图师专用（Kimi K3 多模态）
    // ⚠️ 中国站 platform.kimi.com → https://api.moonshot.cn/v1（充值 ≥10 元解锁 K3）
    //    国际站 platform.kimi.ai → https://api.moonshot.ai/v1（key 不通用）
    // API Key 通过环境变量 MOONSHOT_API_KEY 提供，不写入配置文件
    "kimi": {
      "models": {
        "kimi-k3": {
          "name": "Kimi K3",
          "reasoning": true,
          "limit": { "context": 1000000, "output": 131072 },
          "options": {
            // 制图师场景（看图验证）不需要重度思考，low 省一半 token
            "reasoningEffort": "low"
          }
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:MOONSHOT_API_KEY}",
        "baseURL": "https://api.moonshot.cn/v1",
        "setCacheKey": true
      }
    }
  },

  // ── MCP 服务器 ──
  // 注意：remote 类型 MCP 必须同时指定 type 和 enabled，否则 OC 解析报错
  "mcp": {
    // GitHub MCP：代码仓库操作（PR/Issue/搜索），需要 GitHub PAT
    // 获取 PAT：https://github.com/settings/tokens → 勾选 repo + read:org
    "github": {
      "type": "remote",
      "enabled": true,
      "url": "https://api.githubcopilot.com/mcp/",
      "env": {
        "GITHUB_TOKEN": "ghp_your-github-pat"
      }
    },

    // websearch MCP：Exa AI 搜索（免费匿名可用，有速率限制）
    // 提升额度：https://dashboard.exa.ai/api-keys 获取 Key → 加入 env
    "websearch": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa"
    },

    // gh_grep MCP：GitHub 代码全文搜索（无需认证）
    "gh_grep": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.grep.app"
    },

    // context7 MCP：实时库文档查询（免费 1,000 次/月，无需 Key）
    // 提升额度：https://context7.com 注册 → Dashboard 生成 Key → CONTEXT7_API_KEY
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },

    // playwright MCP：浏览器自动化（导航/点击/截图），用于前端验收闭环
    // 双星截图 → 制图师（Kimi K3 多模态）验收效果；--headless 无头模式
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    }
  },

  // ── 工具权限（全局兜底）──
  // 注意：key 名是 permission（单数），不是 permissions
  "permission": {
    "github": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "gh_grep": "allow",
    "context7": "allow"
  }
}
